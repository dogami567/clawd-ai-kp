{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawd-ai-kp.local/schemas/investigator-card.schema.json",
  "title": "InvestigatorCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "age",
    "occupation",
    "occupationKey",
    "persona",
    "attributes",
    "attributeChecks",
    "skills",
    "resources",
    "inventory",
    "status",
    "identity",
    "skillAllocation",
    "finance",
    "backstory",
    "pointBudgets",
    "creationMethod",
    "inventoryValidation",
    "inventoryAllowance"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "age": { "type": "integer", "minimum": 10, "maximum": 120 },
    "occupation": { "type": "string", "minLength": 1 },
    "occupationKey": { "type": "string", "minLength": 1 },
    "persona": { "type": "string", "minLength": 1 },
    "motivation": { "type": "string" },
    "era": { "type": "string" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residence", "birthplace", "creditRating"],
      "properties": {
        "sex": { "type": "string" },
        "residence": { "type": "string", "minLength": 1 },
        "birthplace": { "type": "string", "minLength": 1 },
        "creditRating": { "type": "integer", "minimum": 0, "maximum": 99 }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STR", "CON", "DEX", "APP", "POW", "INT", "SIZ", "EDU"],
      "properties": {
        "STR": { "type": "integer", "minimum": 1, "maximum": 99 },
        "CON": { "type": "integer", "minimum": 1, "maximum": 99 },
        "DEX": { "type": "integer", "minimum": 1, "maximum": 99 },
        "APP": { "type": "integer", "minimum": 1, "maximum": 99 },
        "POW": { "type": "integer", "minimum": 1, "maximum": 99 },
        "INT": { "type": "integer", "minimum": 1, "maximum": 99 },
        "SIZ": { "type": "integer", "minimum": 1, "maximum": 99 },
        "EDU": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "attributeChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STR", "CON", "DEX", "APP", "POW", "INT", "SIZ", "EDU", "Luck"],
      "properties": {
        "STR": { "$ref": "#/$defs/attributeBlock" },
        "CON": { "$ref": "#/$defs/attributeBlock" },
        "DEX": { "$ref": "#/$defs/attributeBlock" },
        "APP": { "$ref": "#/$defs/attributeBlock" },
        "POW": { "$ref": "#/$defs/attributeBlock" },
        "INT": { "$ref": "#/$defs/attributeBlock" },
        "SIZ": { "$ref": "#/$defs/attributeBlock" },
        "EDU": { "$ref": "#/$defs/attributeBlock" },
        "Luck": { "$ref": "#/$defs/attributeBlock" }
      }
    },
    "occupationTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "creditRatingRange", "occupationSkillFormula", "suggestedSkills"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "creditRatingRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0, "maximum": 99 }
        },
        "occupationSkillFormula": { "type": "string" },
        "suggestedSkills": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pointBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occupation", "interest"],
      "properties": {
        "occupation": { "type": "integer", "minimum": 0 },
        "interest": { "type": "integer", "minimum": 0 }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": "integer", "minimum": 0, "maximum": 99 },
          "baseValue": { "type": "integer", "minimum": 0, "maximum": 99 },
          "occupationPointsSpent": { "type": "integer", "minimum": 0 },
          "interestPointsSpent": { "type": "integer", "minimum": 0 },
          "tag": { "type": "string", "enum": ["investigation", "social", "action", "other"] }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "hpMax", "san", "sanMax", "luck"],
      "properties": {
        "hp": { "type": "integer", "minimum": 0 },
        "hpMax": { "type": "integer", "minimum": 1 },
        "san": { "type": "integer", "minimum": 0, "maximum": 99 },
        "sanMax": { "type": "integer", "minimum": 1, "maximum": 99 },
        "luck": { "type": "integer", "minimum": 0, "maximum": 99 },
        "mp": { "type": "integer", "minimum": 0 },
        "mpMax": { "type": "integer", "minimum": 0 },
        "moveRate": { "type": "integer", "minimum": 1 },
        "baseMoveRate": { "type": "integer", "minimum": 1 },
        "build": { "type": "integer" },
        "damageBonus": { "type": ["integer", "null"] },
        "damageBonusText": { "type": "string" },
        "ageAdjustments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movementPenalty", "eduImprovementChecks", "luckRerolls", "buildPenalty", "notes"],
          "properties": {
            "movementPenalty": { "type": "integer", "minimum": 0 },
            "eduImprovementChecks": { "type": "integer", "minimum": 0 },
            "luckRerolls": { "type": "integer", "minimum": 0 },
            "buildPenalty": { "type": "integer", "minimum": 0 },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["daily", "powerful", "tool", "weapon", "other"] },
          "quantity": { "type": "integer", "minimum": 1, "default": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "inventoryValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "issues"],
      "properties": {
        "ok": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "inventoryAllowance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "mode", "notes"],
      "properties": {
        "allowed": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["direct", "conditional"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "skillAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occupationSpent", "occupationBudget", "interestSpent", "interestBudget", "valid"],
      "properties": {
        "occupationSpent": { "type": "integer", "minimum": 0 },
        "occupationBudget": { "type": "integer", "minimum": 0 },
        "interestSpent": { "type": "integer", "minimum": 0 },
        "interestBudget": { "type": "integer", "minimum": 0 },
        "trackedSkills": { "type": "integer", "minimum": 0 },
        "untrackedSkills": { "type": "integer", "minimum": 0 },
        "valid": { "type": "boolean" }
      }
    },
    "finance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "cash", "assets", "spendingLevel"],
      "properties": {
        "level": { "type": "string", "enum": ["penniless", "poor", "average", "wealthy", "rich", "super_rich"] },
        "cash": { "type": "number", "minimum": 0 },
        "assets": { "type": "number", "minimum": 0 },
        "spendingLevel": { "type": "number", "minimum": 0 }
      }
    },
    "backstory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traits", "beliefs", "significantPeople", "meaningfulLocations", "treasuredPossessions", "injuriesScars", "phobiasManias"],
      "properties": {
        "traits": { "type": "array", "items": { "type": "string" } },
        "beliefs": { "type": "array", "items": { "type": "string" } },
        "significantPeople": { "type": "array", "items": { "type": "string" } },
        "meaningfulLocations": { "type": "array", "items": { "type": "string" } },
        "treasuredPossessions": { "type": "array", "items": { "type": "string" } },
        "injuriesScars": { "type": "array", "items": { "type": "string" } },
        "phobiasManias": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions"],
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["normal", "injured", "critical", "panic", "temporary_insanity", "indefinite_insanity", "unconscious"]
          }
        },
        "majorWound": { "type": "boolean" },
        "temporaryInsanity": { "type": "boolean" },
        "indefiniteInsanity": { "type": "boolean" },
        "temporaryEffects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "expiresAtRound"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "expiresAtRound": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "creationMethod": { "type": "string", "enum": ["quick_fire", "traditional_random"] },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "era": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "attributeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "half", "fifth"],
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "half": { "type": "integer", "minimum": 0, "maximum": 100 },
        "fifth": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
