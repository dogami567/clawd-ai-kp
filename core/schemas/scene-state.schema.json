{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawd-ai-kp.local/schemas/scene-state.schema.json",
  "title": "SceneState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "sceneId",
    "sceneType",
    "timeState",
    "participants",
    "clues",
    "events",
    "threats",
    "nextOptions"
  ],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "sceneId": { "type": "string", "minLength": 1 },
    "sceneType": { "type": "string", "enum": ["intro", "investigation", "social", "combat", "transition", "settlement"] },
    "summary": { "type": "string" },
    "location": { "type": "string" },
    "timeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timelineMinute", "combatRound", "countdowns"],
      "properties": {
        "timelineMinute": { "type": "integer", "minimum": 0 },
        "combatRound": { "type": "integer", "minimum": 0 },
        "countdowns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "remaining", "unit"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "remaining": { "type": "integer", "minimum": 0 },
              "unit": { "type": "string", "enum": ["round", "minute", "scene"] },
              "effect": { "type": "string", "enum": ["steal_discovery", "follow_alert", "route_shift", "search_sweep", "reinforcements_arrive", "opportunity_close"] },
              "targetNpc": { "type": "string" },
              "targetItem": { "type": "string" },
              "routeHint": { "type": "string" },
              "followupDelayMinutes": { "type": "integer", "minimum": 0 },
              "routeShiftDelayMinutes": { "type": "integer", "minimum": 0 },
              "escalateToReinforcements": { "type": "boolean" },
              "reinforcementDelayMinutes": { "type": "integer", "minimum": 0 },
              "reinforcementAmount": { "type": "integer", "minimum": 0 },
              "reinforcementLabel": { "type": "string" },
              "optionId": { "type": "string" },
              "clueId": { "type": "string" },
              "sourceCountdown": { "type": "string" },
              "amount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "participants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["investigators", "npcs"],
      "properties": {
        "investigators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "npcs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "attitude", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "attitude": { "type": "string", "enum": ["friendly", "neutral", "guarded", "hostile", "unknown"] },
              "status": { "type": "string", "enum": ["active", "down", "escaped", "arriving"] },
              "arrivalRound": { "type": "integer", "minimum": 0 },
              "trust": { "type": "integer", "minimum": -5, "maximum": 5 },
              "items": { "type": "array", "items": { "type": "string" } },
              "socialState": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "suspicion": { "type": "integer", "minimum": 0, "maximum": 5 },
                  "fear": { "type": "integer", "minimum": 0, "maximum": 5 },
                  "affinity": { "type": "integer", "minimum": 0, "maximum": 5 },
                  "obligation": { "type": "integer", "minimum": 0, "maximum": 5 },
                  "lastInteractionStyle": { "type": "string", "enum": ["persuade", "charm", "intimidate", "bribery", "empathy"] },
                  "flags": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "revealed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["core", "optional", "partial", "false_lead"] },
          "revealed": { "type": "boolean" },
          "quality": { "type": "string", "enum": ["clear", "partial", "distorted"] },
          "source": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "triggered"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "triggered": { "type": "boolean" },
          "triggerAtMinute": { "type": "integer", "minimum": 0 },
          "routeHint": { "type": ["string", "null"] },
          "reinforcements": { "type": "integer", "minimum": 0 },
          "sourceNpc": { "type": ["string", "null"] }
        }
      }
    },
    "threats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposure", "pressure", "dangerLevel"],
      "properties": {
        "exposure": { "type": "integer", "minimum": 0, "maximum": 10 },
        "pressure": { "type": "integer", "minimum": 0, "maximum": 10 },
        "dangerLevel": { "type": "string", "enum": ["low", "medium", "high", "extreme"] }
      }
    },
    "nextOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["investigate", "talk", "move", "fight", "fallback", "other"] },
          "requires": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "scenarioId": { "type": "string" },
        "scenarioTitle": { "type": "string" },
        "opening": { "type": "string" },
        "starterPrompts": { "type": "array", "items": { "type": "string" } },
        "atmosphere": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tone": { "type": "string" },
            "smell": { "type": "array", "items": { "type": "string" } },
            "sound": { "type": "array", "items": { "type": "string" } },
            "light": { "type": "string" }
          }
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "notable": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "truthLayers": { "type": "array", "items": { "type": "string" } },
        "endingHooks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
