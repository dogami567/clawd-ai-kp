{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawd-ai-kp.local/schemas/story-pack.schema.json",
  "title": "StoryPackTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "campaignId", "sceneIds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "campaignId": { "type": "string", "minLength": 1 },
    "sceneIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
